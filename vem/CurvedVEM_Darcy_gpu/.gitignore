# ====================
# 运行输出（不上传）
# ====================
output/

# ====================
# 根 .gitignore 的 *.cpp 规则会把源码一并忽略，
# 本项目的 C++ 源文件需要跟踪，在此逐层取消。
# 根规则 core*（本意忽略 core dump）会误伤 core/ 源码目录。
# ====================
!*.cpp
!core/
!core/**

# 根规则中 "!Makefile" 因行内带注释失效，项目自有 Makefile 需要跟踪。
!Makefile

# ====================
# 网格输入随仓库上传（根 data/ 规则会排除 mesh/data 目录）
# ====================
!mesh/data/
!mesh/data/**
# vtk 演示文件仍遵循根规则，不上传
mesh/data/*.vtk
